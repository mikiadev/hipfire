    const unsigned char KSIGNS_IQ2XS[128] = {
    0, 129, 130, 3, 132, 5, 6, 135, 136, 9, 10, 139, 12, 141, 142, 15,
    144, 17, 18, 147, 20, 149, 150, 23, 24, 153, 154, 27, 156, 29, 30, 159,
    160, 33, 34, 163, 36, 165, 166, 39, 40, 169, 170, 43, 172, 45, 46, 175,
    48, 177, 178, 51, 180, 53, 54, 183, 184, 57, 58, 187, 60, 189, 190, 63,
    192, 65, 66, 195, 68, 197, 198, 71, 72, 201, 202, 75, 204, 77, 78, 207,
    80, 209, 210, 83, 212, 85, 86, 215, 216, 89, 90, 219, 92, 221, 222, 95,
    96, 225, 226, 99, 228, 101, 102, 231, 232, 105, 106, 235, 108, 237, 238, 111,
    240, 113, 114, 243, 116, 245, 246, 119, 120, 249, 250, 123, 252, 125, 126, 255
};

__launch_bounds__(32, 20)
extern "C" __global__ void gemv_iq2_xxs(
    const unsigned char* __restrict__ A_iq2xxs, // [M, K/256 * 66] packed IQ2_XXS
    const float* __restrict__ x,                // [K]
    float* __restrict__ y,                      // [M]
    int M, int K
) {
    const int row = blockIdx.x;
    if (row >= M) return;
    const int tid = threadIdx.x;

    const int blocks_per_row = K / 256;
    const unsigned char* row_data = A_iq2xxs + (size_t)row * blocks_per_row * 66;

    float sum = 0.0f;

    for (int bi = 0; bi < blocks_per_row; bi++) {
        const unsigned char* block = row_data + bi * 66;
        float d = half_to_float((unsigned short)(block[0] | (block[1] << 8)));
        const unsigned char* qs = block + 2;
        const float* xb = x + bi * 256;

        #pragma unroll
        for (int ib32 = 0; ib32 < 8; ib32++) {
            int off = 8 * ib32;
            unsigned int a1 = (unsigned int)qs[off+4]
                            | ((unsigned int)qs[off+5] << 8)
                            | ((unsigned int)qs[off+6] << 16)
                            | ((unsigned int)qs[off+7] << 24);
            float db = d * (0.5f + (float)(a1 >> 28)) * 0.25f;
            int l = tid >> 3;
            int j = tid & 7;
            unsigned long long grid = IQ2XXS_GRID[qs[off + l]];
            unsigned char signs = KSIGNS_IQ2XS[(a1 >> (7 * l)) & 127];
            int gb = (int)(int8_t)((grid >> (8 * j)) & 0xff);
            float w = db * (float)gb * ((signs & (1 << j)) ? -1.0f : 1.0f);
            sum += w * xb[ib32 * 32 + tid];
        }
    }

    for (int offset = 16; offset > 0; offset >>= 1) {
        sum += __shfl_down(sum, offset);
    }
    if (tid == 0) y[row] = sum;
}
