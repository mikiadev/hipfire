__launch_bounds__(32, 20)
extern "C" __global__ void gemv_iq2_s(
    const unsigned char* __restrict__ A_iq2s,  // [M, K/256 * 82] packed IQ2_S
    const float* __restrict__ x,               // [K]
    float* __restrict__ y,                     // [M]
    int M, int K
) {
    const int row = blockIdx.x;
    if (row >= M) return;
    const int tid = threadIdx.x;

    const int blocks_per_row = K / 256;
    const unsigned char* row_data = A_iq2s + (size_t)row * blocks_per_row * 82;

    float sum = 0.0f;

    for (int bi = 0; bi < blocks_per_row; bi++) {
        const unsigned char* block = row_data + bi * 82;
        float d = half_to_float((unsigned short)(block[0] | (block[1] << 8)));
        const unsigned char* qs = block + 2;
        const unsigned char* qh = block + 66;
        const unsigned char* scales = block + 74;
        const float* xb = x + bi * 256;

        #pragma unroll
        for (int ib32 = 0; ib32 < 8; ib32++) {
            int sc = scales[ib32];
            int l = tid >> 3;
            int j = tid & 7;
            float dl = d * (0.5f + (float)(l < 2 ? (sc & 0xf) : (sc >> 4))) * 0.25f;
            int grid_idx = (int)qs[ib32 * 4 + l] | ((qh[ib32] << (8 - 2 * l)) & 0x300);
            unsigned long long grid = IQ2S_GRID[grid_idx];
            int gb = (int)(int8_t)((grid >> (8 * j)) & 0xff);
            unsigned char s = qs[32 + ib32 * 4 + l];
            float w = dl * (float)gb * ((s & (1 << j)) ? -1.0f : 1.0f);
            sum += w * xb[ib32 * 32 + tid];
        }
    }

    // Warp shuffle reduction (5 steps, no shared memory)
    for (int offset = 16; offset > 0; offset >>= 1) {
        sum += __shfl_down(sum, offset);
    }
    if (tid == 0) y[row] = sum;
}
